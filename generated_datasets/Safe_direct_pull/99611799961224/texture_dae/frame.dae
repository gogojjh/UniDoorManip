    <effect id="material_0_0_4949-effect">
      <profile_COMMON>
        <newparam sid="texture_1_jpg_040-surface">
          <surface type="2D">
            <init_from>texture_1_jpg_040</init_from>
          </surface>
        </newparam>
        <newparam sid="texture_1_jpg_040-sampler">
          <sampler2D>
            <source>texture_1_jpg_040-surface</source>
